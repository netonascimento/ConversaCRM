PORT=3000
PUBLIC_URL=http://localhost:3000

# Primeiro administrador da plataforma (criado ao iniciar, se ainda não existir). Painel em /admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Cadastro de teste grátis pela página inicial (true/false)
ALLOW_SIGNUP=true
# Pix manual da assinatura (opcional): só é usado quando o Stripe não está configurado
PLATFORM_PIX_KEY=
PLATFORM_PIX_NAME=Falaki
PLATFORM_PIX_CITY=Sao Paulo
# Stripe: assinatura no cartão. Em desenvolvimento use a chave de TESTE (sk_test_/rk_test_);
# chave de produção (sk_live_/rk_live_) fica bloqueada enquanto PUBLIC_URL for localhost.
# Cartão = assinatura mensal automática; Pix = um mês por pagamento (ative o Pix nas formas de pagamento do Stripe).
# Webhook: PUBLIC_URL/webhooks/stripe com os eventos checkout.session.completed, checkout.session.async_payment_succeeded,
# invoice.paid, invoice.payment_failed, customer.subscription.updated e customer.subscription.deleted.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# WhatsApp por QR Code gerenciado: servidor Evolution API da plataforma (um para todas as empresas).
# Com isto preenchido, o cliente só lê o QR Code; sem isto, ele configura a conexão à mão.
# Pelo QR Code, a prospecção manda no máximo 20 primeiras mensagens por dia (proteção contra bloqueio).
EVOLUTION_URL=
EVOLUTION_API_KEY=
# E-mail para onde o cliente envia o comprovante
SALES_EMAIL=contato@falaki.me
# WhatsApp de vendas (os botões dos planos pagos abrem uma conversa com ele)
SALES_WHATSAPP=

# Chave da IA da plataforma: só usada pelas empresas marcadas no painel /admin (consumo cobrado à parte).
# As demais empresas cadastram a própria chave em Configurações → Integrações.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
GOOGLE_PLACES_API_KEY=
# Google Agenda (OAuth do Google Cloud). Redirecionamento: PUBLIC_URL/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# DB_PATH=data/falaki.db
# SCHEDULER_INTERVAL_MS=60000

PORT=3000
PUBLIC_URL=http://localhost:3000

# Primeiro administrador da plataforma (criado ao iniciar, se ainda não existir). Painel em /admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Cadastro de teste grátis pela página inicial (true/false)
ALLOW_SIGNUP=true
# WhatsApp de vendas (os botões dos planos pagos abrem uma conversa com ele)
SALES_WHATSAPP=

ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
GOOGLE_PLACES_API_KEY=
# Google Agenda (OAuth do Google Cloud). Redirecionamento: PUBLIC_URL/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# DB_PATH=data/fechou.db
# SCHEDULER_INTERVAL_MS=60000
